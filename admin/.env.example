# API Base URL
VITE_API_BASE_URL=http://localhost:8090

# Default UI locale (en | es) — the header switcher overrides it per browser
VITE_DEFAULT_LOCALE=en

# Dev server port (change when running several stacks at once)
VITE_PORT=5191

# Dev auto-login — managed by `npm run auth:off` / `npm run auth:on`.
# Do not set these by hand; the command reads JWT_SECRET_KEY from ../core/.env.
# VITE_DEV_AUTO_LOGIN=true
# VITE_DEV_STUB_ADMIN=true
# VITE_DEV_ADMIN_TOKEN=...
