# Server
PORT=8003

# WAHA (self-hosted WhatsApp HTTP API) — use a GOWS image/tag.
WAHA_BASE_URL=http://localhost:3000
# Must match WAHA's WAHA_API_KEY. Sent as X-Api-Key to every WAHA call.
WAHA_API_KEY=your_waha_api_key
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change_this_dashboard_password

# The adapter can create/start the session automatically when this URL is set.
# It must be reachable FROM the WAHA container. For docker-compose this is
# http://whatsapp-waha:8003/webhook; for a local WAHA + ngrok use the public URL.
WAHA_WEBHOOK_URL=http://localhost:8003/webhook
# Signs every webhook body (X-Webhook-Hmac, SHA-512). Set the same value in the
# session's webhook config; leave empty only for local development.
WAHA_WEBHOOK_HMAC_KEY=your_webhook_hmac_key
WAHA_AUTO_START_SESSION=true

# WAHA /api/sendVoice convert=true uses ffmpeg to make browser audio playable
# as a WhatsApp voice note. Set false if your WAHA image has no ffmpeg.
WAHA_VOICE_CONVERT=true

# Inbound media is inlined as a data: URI (the core can never fetch a WAHA URL).
# 25 MB aligns with the admin panel's document limit.
MAX_MEDIA_BYTES=26214400

# Durable idempotency for WAHA webhook retries (SQLite; shared by all workers).
WAHA_DEDUP_DB_PATH=/tmp/chasqui-waha-dedup.sqlite3
DEDUP_TTL_SECONDS=86400

# Chasqui core
CORE_URL=http://localhost:8090
INTERNAL_API_KEY=

# User-facing fallbacks — English defaults; set them in your users' language.
# (The agent localizes itself via the system prompt; these only fire when the
# core is unreachable or the message type isn't handled.)
# ERROR_REPLY=Sorry, we hit a technical issue. Please try again in a few minutes.
# UNSUPPORTED_REPLY=For now I only handle text, audio, images, videos and documents. Send me a message and I'll be glad to help.

# Sentry (optional)
SENTRY_DSN=
